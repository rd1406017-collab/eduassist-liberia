# ─────────────────────────────────────────────────────────────
#  EduAssist — Environment Variables
#  IMPORTANT: Never share or commit this file to GitHub!
#  Add .env to your .gitignore file.
# ─────────────────────────────────────────────────────────────

# Your Anthropic API Key (get it from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Server port (3000 is default, Render/Railway may set this automatically)
PORT=3000

# Allowed origins — set this to your actual domain in production
# Example: https://eduassist.moe.gov.lr,https://www.eduassist.moe.gov.lr
# Use * to allow all origins (only for local development)
ALLOWED_ORIGINS=*
